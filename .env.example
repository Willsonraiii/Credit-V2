# Copy this file to `.env` and fill in your Supabase project values.
# These are found in Supabase Dashboard → Project Settings → API.
#
# The anon/public key is safe to include in the frontend bundle — access to
# the actual data is controlled by Row Level Security in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
